{
  "theme": "light",
  "window": {
    "width": 900,
    "height": 580,
    "always_on_top": false
  },
  "clipboard_history_limit": 50,
  "clipboard_popup_hotkey": {
    "modifiers": [
      "ctrl",
      "alt",
      "shift"
    ],
    "key": "1"
  },
  "clipboard_popup_double_ctrl": true,
  "hotkeys_enabled": true,
  "auto_update_check": true,
  "auto_update_install": true,
  "startup_with_windows": true,
  "active_preset": 1,
  "github_token": ""
}